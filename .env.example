# Affiliate tracking environment variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# Wise Partnerize camref — obtain from the Partnerize dashboard after Wise affiliate approval.
# When set, Wise links use the Partnerize tracking URL format:
#   https://prf.hn/click/camref:{VITE_WISE_CAMREF}/adref:{corridorId}/destination:{encoded_wise_url}
VITE_WISE_CAMREF=

# Remitly affiliate ID — obtain from the Remitly partner dashboard after affiliate approval.
VITE_REMITLY_AFFILIATE_ID=

# Wise rates proxy URL (optional, only needed if Wise /v1/rates is CORS-blocked in browser)
# In development, Vite proxy handles this automatically.
# In production, set to your deployed proxy URL (e.g., Cloudflare Worker).
# Leave empty to attempt direct browser fetch to api.wise.com first.
VITE_WISE_RATES_PROXY_URL=

# Wise API proxy URL - set to your deployed Cloudflare Worker URL
# Required for live quotes from Wise Quote API and Comparison API
VITE_WISE_PROXY_URL=
